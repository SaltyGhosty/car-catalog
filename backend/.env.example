# Copia questo file in ".env" (stessa cartella, backend/) e compila i valori.
# Il file .env è in .gitignore: NON va mai committato.

# --- Gmail (notifiche prezzo e reset password) ---
# MAIL_USERNAME: l'indirizzo Gmail che invia le mail
# MAIL_PASSWORD: una "App Password" di Google (16 caratteri), NON la password normale
#   -> https://myaccount.google.com/apppasswords (richiede la verifica in due passaggi)
MAIL_USERNAME=
MAIL_PASSWORD=

# --- Opzionali in locale (il profilo dev ha già valori di sviluppo) ---
# DATABASE_URL=postgresql://carcatalog:carcatalog@localhost:5432/carcatalog
# JWT_SECRET=
# ADMIN_EMAIL=admin@carcatalog.local
# ADMIN_PASSWORD=
# ALLOWED_ORIGIN=http://localhost:5173
